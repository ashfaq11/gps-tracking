{
  "info": {
    "name": "GPS Tracking API",
    "description": "Endpoints served by `python -m api`.\n\nStart the stack first:\n```\ndocker exec -i postgres-local psql -U postgres -d trackit -v ON_ERROR_STOP=1 < sql/schema.sql\nexport PG_DSN=postgresql://postgres:postgres@localhost:5432/trackit\npython3 -m gps_gateway            # terminal 1\nINGEST_API_KEY=dev python3 -m api # terminal 2\n```\n\nNote: GT06 trackers do NOT use this API. They speak raw TCP binary to the gateway on :5023 \u2014 see `tools/simulate_device.py`. The ingest endpoint here is for phone apps and HTTP-capable clients.\n\nRun the whole collection to execute the assertions in each request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:55920",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "dev",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "868120303372449",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(b.status).to.eql('ok'));",
                  "pm.test('database reachable', () => pm.expect(b.database).to.eql('ok'));",
                  "console.log('backend =', b.backend);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Ingest",
      "item": [
        {
          "name": "Ingest a location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingest/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ingest",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{deviceId}}\",\n  \"latitude\": 12.971598,\n  \"longitude\": 77.594566,\n  \"speed_kmh\": 42,\n  \"course_deg\": 15,\n  \"gps_fixed\": true,\n  \"satellites\": 9,\n  \"fixed_at\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));",
                  "const b = pm.response.json();",
                  "pm.test('accepted', () => pm.expect(b.status).to.eql('accepted'));",
                  "pm.test('echoes device id', () =>",
                  "  pm.expect(b.device_id).to.eql(pm.variables.replaceIn('{{deviceId}}')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest a second fix (moved north)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingest/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ingest",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{deviceId}}\",\n  \"latitude\": 12.981598,\n  \"longitude\": 77.594566,\n  \"speed_kmh\": 55,\n  \"course_deg\": 15,\n  \"gps_fixed\": true,\n  \"satellites\": 9,\n  \"fixed_at\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest for a second device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingest/location",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ingest",
                "location"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"phone-app-01\",\n  \"latitude\": 19.076,\n  \"longitude\": 72.8777,\n  \"speed_kmh\": 0,\n  \"course_deg\": 15,\n  \"gps_fixed\": true,\n  \"satellites\": 9,\n  \"fixed_at\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "List devices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns an array', () => pm.expect(b).to.be.an('array'));",
                  "pm.test('includes our device', () =>",
                  "  pm.expect(b.map(d => d.device_id))",
                  "    .to.include(pm.variables.replaceIn('{{deviceId}}')));",
                  "pm.test('each row has last_seen and fix_count', () =>",
                  "  b.forEach(d => { pm.expect(d).to.have.property('last_seen');",
                  "                   pm.expect(d).to.have.property('fix_count'); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Latest fix for a device",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{deviceId}}",
                "latest"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('is the most recent fix', () => pm.expect(b.latitude).to.eql(12.981598));",
                  "pm.test('longitude is positive (east of Greenwich)', () =>",
                  "  pm.expect(b.longitude).to.be.above(0));",
                  "pm.test('has a received_at', () => pm.expect(b.received_at).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Location history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/locations?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{deviceId}}",
                "locations"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('respects the limit', () => pm.expect(b.length).to.be.at.most(10));",
                  "pm.test('newest first', () => {",
                  "  const times = b.map(r => new Date(r.received_at).getTime());",
                  "  pm.expect(times).to.eql([...times].sort((a, z) => z - a));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Location history since a timestamp",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/devices/{{deviceId}}/locations?since=2020-01-01T00:00:00Z&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{deviceId}}",
                "locations"
              ],
              "query": [
                {
                  "key": "since",
                  "value": "2020-01-01T00:00:00Z"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('at most 5 rows', () => pm.expect(pm.response.json().length).to.be.at.most(5));"
                ]
              }
            }
          ]
        }
      ]
    },
